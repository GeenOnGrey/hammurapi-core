# Версии выкатки hammurapi-core (PLT.INFRA-0002). Меняются только через PR:
# так выкатка любого тега воспроизводима.

# Тег публичного репозитория hammurapi с переиспользуемым workflow deploy-component.yml.
# После изменения выполните deploy/sync-ref.sh — он подставит её в release.yml
# (в uses: нельзя использовать выражения).
DEPLOY_WORKFLOW_REF=v0.1.0

# Версия чартов в oci://ghcr.io/greenongrey/charts.
CHART_VERSION=0.1.0

# ACP-агент в образе core (@agentclientprotocol/claude-agent-acp).
AGENT_VERSION=0.84.0
